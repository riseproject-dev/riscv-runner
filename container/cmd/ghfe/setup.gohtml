{{/* SPDX-License-Identifier: MIT */}}
{{define "head"}}<meta charset="utf-8"><title>{{.Title}}</title>
<style>body { font-family: -apple-system, system-ui, sans-serif; max-width: 640px; margin: 3rem auto; padding: 0 1rem; color: #222; }
h1 { font-size: 1.5rem; }
.ok { color: #0a7f2e; }
.err { color: #b00020; }
a.button { display: inline-block; background: #0969da; color: #fff; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; margin-top: 0.5rem; }
code { background: #f3f3f3; padding: 0.1rem 0.3rem; border-radius: 3px; }</style>{{end}}

{{define "missing"}}<!doctype html>
<html><head>{{template "head" .}}</head>
<body>
<h1 class="err">Missing installation id</h1>
<p>This page is the post-install redirect target for the RISE RISC-V Runners GitHub Apps. It expects an <code>installation_id</code> query parameter, which GitHub normally appends after installation.</p>
<p>If you got here by mistake, you can (re-)install one of the apps:</p>
<p><a class="button" href="{{.OrgURL}}">Install on an organization</a> <a class="button" href="{{.PersonalURL}}">Install on a personal account</a></p>
</body></html>
{{end}}

{{define "wrongApp"}}<!doctype html>
<html><head>{{template "head" .}}</head>
<body>
<h1 class="err">Installation not found for this app</h1>
<p>We couldn't find installation <code>{{.InstallationID}}</code> under the app you just installed. The most likely cause is that you installed the <strong>{{.ExpectedHuman}} app</strong> on a <strong>{{.WrongAppName}} account</strong> — these two must match.</p>
<p>Please uninstall it from your GitHub settings and install the correct app:</p>
<p><a class="button" href="{{.RightURL}}">Install the {{.WrongAppName}} app</a></p>
</body></html>
{{end}}

{{define "upstreamError"}}<!doctype html>
<html><head>{{template "head" .}}</head>
<body>
<h1 class="err">Something went wrong</h1>
<p>GitHub returned an error while validating your installation (<code>{{.Status}}</code>). Please try again in a minute, or contact the RISE team if the problem persists.</p>
</body></html>
{{end}}

{{define "installedOK"}}<!doctype html>
<html><head>{{template "head" .}}</head>
<body>
<h1 class="ok">All set, {{.Login}}!</h1>
<p>The RISE RISC-V Runners {{.Kind}} app is correctly installed on <code>{{.Login}}</code>.</p>
<p>You can now trigger GitHub Actions jobs with the <code>ubuntu-24.04-riscv</code> label and they will be picked up automatically.</p>
</body></html>
{{end}}

{{define "wrongType"}}<!doctype html>
<html><head>{{template "head" .}}</head>
<body>
{{if .ExpectedOrg}}
<h1 class="err">You installed the organization app on a personal account</h1>
<p>The <strong>RISE RISC-V Runners</strong> (organization) app was installed on personal account <code>{{.Login}}</code>. It only works on GitHub <em>organizations</em>.</p>
<p>For personal accounts, install the dedicated personal app instead:</p>
<p><a class="button" href="{{.OtherURL}}">Install the personal app</a></p>
<p>You should also uninstall the organization app from <code>{{.Login}}</code>'s GitHub settings to avoid confusion.</p>
{{else}}
<h1 class="err">You installed the personal app on an organization</h1>
<p>The <strong>RISE RISC-V Runners (personal)</strong> app was installed on organization <code>{{.Login}}</code>. It only works on personal GitHub accounts.</p>
<p>For organizations, install the dedicated organization app instead:</p>
<p><a class="button" href="{{.OtherURL}}">Install the organization app</a></p>
<p>You should also uninstall the personal app from <code>{{.Login}}</code>'s GitHub settings to avoid confusion.</p>
{{end}}
</body></html>
{{end}}
